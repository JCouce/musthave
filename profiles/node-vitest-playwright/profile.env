# Perfil Node + TypeScript + Vitest (unitarios) + Playwright (e2e).
# Lo carga el núcleo antes que project.env, así que el proyecto puede pisar cualquier valor.
INSTALL_CMD="npm ci --ignore-scripts --no-audit --no-fund"
TYPECHECK_CMD="npx tsc --noEmit"
# $PORT lo pone el evaluador. Por defecto Vite; cámbialo en project.env si tu app se sirve de otra forma.
SERVE_CMD='npx vite build && npx vite preview --port "$PORT" --strictPort'
# Comandos que puede lanzar el constructor además de la base común (git, ls, check.sh, init.sh).
BUILD_TOOLS="Bash(npm install *),Bash(npm i *),Bash(npm run *),Bash(npm ls *),Bash(npx tsc *),Bash(npx vitest *),Bash(npx vite *),Bash(npx playwright *),Bash(node *)"
TRAP_PATHS="src"
# Código que se comporta distinto cuando lo prueban: Vitest, NODE_ENV o el navegador automatizado.
TRAP_PATTERNS='import\.meta\.vitest|process\.env\.(VITEST|NODE_ENV)|__vitest|navigator\.webdriver'
REQUIRES="node npx"
# Lo que new-project.sh añade al .gitignore del repo.
GITIGNORE="node_modules dist test-results playwright-report"
