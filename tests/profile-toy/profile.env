# Perfil de juguete para los tests del núcleo: tests en bash, sin instalar ni compilar nada.
INSTALL_CMD=""
TYPECHECK_CMD=""
SERVE_CMD=""
BUILD_TOOLS=""
TRAP_PATHS="src"
# El runner exporta IN_ACCEPTANCE_TEST=1: código que lo mire está detectando el test (como process.env.VITEST).
TRAP_PATTERNS='IN_ACCEPTANCE_TEST'
