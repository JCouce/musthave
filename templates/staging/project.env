# Configuración del proyecto para el harness. Va al oráculo al congelar (cambiarla = recongelar).
PROJECT={{PROJECT}}
REPO={{REPO}}
# Perfil de stack: nombre de una carpeta de profiles/ (o ruta absoluta a un perfil propio).
PROFILE={{PROFILE}}
BUILD_MODEL=opus
EVAL_MODEL=sonnet

# Ficheros de mirror/ que el evaluador puede cargar en la app (separados por espacios).
EVAL_FILES=""
# Comandos extra para el constructor, además de los del perfil. Ej.: "Bash(pdftotext *),Bash(pdfinfo *)"
EXTRA_BUILD_TOOLS=""

# Cualquier valor del perfil se puede pisar aquí: INSTALL_CMD, TYPECHECK_CMD, SERVE_CMD, TRAP_PATTERNS, TRAP_PATHS…
# Topes del bucle (también como variables de entorno al lanzar): MAX_ATTEMPTS=3 MAX_ITER=3×features+10 STALL_N=8
